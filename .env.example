# Copiá este archivo a .env y completalo solo si vas a usar crédito de verdad.
# Sin claves, python main.py entra en MODO DEMOSTRACIÓN y no llama a ninguna API.
#
# LLM_PROVIDER elige el proveedor: openai, anthropic o demo.
# demo fuerza el simulador local. Si ponés openai o anthropic y la clave
# está vacía, main.py también se queda en el simulador.

LLM_PROVIDER=demo
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Opcional. Si no están, el código usa estos mismos valores.
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-5-5

# Segundos entre fragmentos del simulador. 0 los imprime de una.
DEMO_PAUSA_SEG=0.02
